{
  "$defs": {
    "Annotation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "category": {
          "enum": [
            "finding",
            "method",
            "result",
            "comparison",
            "limitation"
          ],
          "title": "Category",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "accepted_statements": {
          "items": {
            "type": "string"
          },
          "title": "Accepted Statements",
          "type": "array"
        }
      },
      "required": [
        "id",
        "category",
        "statement",
        "evidence_ids"
      ],
      "title": "Annotation",
      "type": "object"
    },
    "Case": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "synthetic",
            "real"
          ],
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identifier"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "domain": {
          "enum": [
            "qsar_admet",
            "representations_gnn",
            "uncertainty",
            "active_learning",
            "generative_design",
            "structure_based",
            "foundation_models"
          ],
          "title": "Domain",
          "type": "string"
        },
        "source_ref": {
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "source_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sha256"
        },
        "evidence_scope": {
          "enum": [
            "abstract_only",
            "full_text",
            "unknown"
          ],
          "title": "Evidence Scope",
          "type": "string"
        },
        "passages": {
          "items": {
            "$ref": "#/$defs/Passage"
          },
          "title": "Passages",
          "type": "array"
        },
        "annotations": {
          "items": {
            "$ref": "#/$defs/Annotation"
          },
          "title": "Annotations",
          "type": "array"
        },
        "quantities": {
          "items": {
            "$ref": "#/$defs/Quantity"
          },
          "title": "Quantities",
          "type": "array"
        },
        "must_not_infer": {
          "items": {
            "$ref": "#/$defs/NegativeControl"
          },
          "title": "Must Not Infer",
          "type": "array"
        },
        "reference_summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Summary"
        },
        "review": {
          "$ref": "#/$defs/Review"
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "domain",
        "source_ref",
        "evidence_scope",
        "review"
      ],
      "title": "Case",
      "type": "object"
    },
    "NegativeControl": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "error_type": {
          "enum": [
            "value",
            "unit",
            "metric",
            "dataset",
            "direction",
            "conditions",
            "validation",
            "experimental_confirmation",
            "significance",
            "superiority",
            "unsupported_result",
            "qualification"
          ],
          "title": "Error Type",
          "type": "string"
        },
        "support": {
          "enum": [
            "contradicted",
            "insufficient_evidence"
          ],
          "title": "Support",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "annotation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Annotation Id"
        }
      },
      "required": [
        "id",
        "statement",
        "error_type",
        "support",
        "evidence_ids",
        "rationale"
      ],
      "title": "NegativeControl",
      "type": "object"
    },
    "Passage": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "section": {
          "title": "Section",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        }
      },
      "required": [
        "id",
        "text",
        "section"
      ],
      "title": "Passage",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "annotation_id": {
          "title": "Annotation Id",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "metric": {
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "dataset": {
          "minLength": 1,
          "title": "Dataset",
          "type": "string"
        },
        "direction": {
          "minLength": 1,
          "title": "Direction",
          "type": "string"
        },
        "conditions": {
          "minLength": 1,
          "title": "Conditions",
          "type": "string"
        },
        "baseline": {
          "minLength": 1,
          "title": "Baseline",
          "type": "string"
        }
      },
      "required": [
        "annotation_id",
        "value",
        "unit",
        "metric",
        "dataset",
        "direction",
        "conditions",
        "baseline"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "Review": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "synthetic",
            "unreviewed",
            "verified"
          ],
          "title": "Status",
          "type": "string"
        },
        "annotator": {
          "minLength": 1,
          "title": "Annotator",
          "type": "string"
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "notes": {
          "minLength": 1,
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "status",
        "annotator",
        "notes"
      ],
      "title": "Review",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "benchmark_version": {
      "minLength": 1,
      "title": "Benchmark Version",
      "type": "string"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/Case"
      },
      "title": "Cases",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "benchmark_version",
    "cases"
  ],
  "title": "Benchmark",
  "type": "object"
}
